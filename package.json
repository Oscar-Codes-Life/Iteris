{
  "name": "iteris",
  "version": "1.2.0",
  "description": "Autonomous ticket shipper powered by Claude Code and Codex",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Oscar-Codes-Life/Iteris#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oscar-Codes-Life/Iteris.git"
  },
  "bugs": {
    "url": "https://github.com/Oscar-Codes-Life/Iteris/issues"
  },
  "packageManager": "pnpm@10.28.0",
  "files": ["dist", "assets/iteris-icon.png", "assets/Iteris-cover.png", "assets/instances-preview.png", "CHANGELOG.md", "docs/lifecycle.md", "docs/examples", "docs/releases", "docs/releasing.md"],
  "bin": {
    "iteris": "./dist/index.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=4 tests/*.test.mjs",
    "test:soak": "npm run build && node --test tests/soak/*.test.mjs",
    "eval:review": "npm run build && node eval/review/run.mjs",
    "release:check": "node scripts/check-release.mjs",
    "prepack": "npm run build && npm run release:check"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@octokit/rest": "^21.1.1",
    "ink": "^5.2.0",
    "react": "^18.3.1",
    "slugify": "^1.6.6",
    "terminal-image": "^4.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@sindresorhus/tsconfig": "^7.0.0",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "typescript": "^5.8.2"
  }
}
